# deploy/.env.prod.example — required inputs for `docker compose --env-file ...`.
#
# Copy to a file OUTSIDE the checkout (e.g. /etc/market-ops/prod.env), owned and
# readable only by the deployment account, fill in every value, and pass it
# explicitly via `--env-file`. Compose refuses to start with any required value
# (the `${VAR:?...}` form in compose.prod.yml) unset; it does NOT silently
# default. See DEPLOYMENT.md §6.2 and §10.
#
#   sudo install -d -m 0750 -o "$USER" -g "$USER" /etc/market-ops
#   install -m 0600 deploy/.env.prod.example /etc/market-ops/prod.env
#   export ENVFILE=/etc/market-ops/prod.env
#
# Fill in every value BELOW the image block by hand. The `task prod:*` commands
# all read $ENVFILE and fail closed when it is unset or unreadable.

# ─── Digest-pinned images — DO NOT EDIT BY HAND ────────────────────────
# These four lines are owned by tools/deploy/release_images.sh, which copies them
# out of the `image-digests-<version>` artifact .github/workflows/release.yml
# uploads on a published tag (DEPLOYMENT.md §6.1):
#
#   task release:images -- --tag v0.1.0 --env-file "$ENVFILE"
#   task release:images -- --from ~/images.env --env-file "$ENVFILE"   # no gh
#   task release:images -- --resolve v0.1.0 --env-file "$ENVFILE"      # via GHCR
#   task release:images:check                                          # still there?
#
# It replaces these lines in place, leaves every other line untouched, and saves
# the digests it replaced to $ENVFILE.prev-images (the `task prod:rollback`
# input). It refuses anything not @sha256-pinned: a tag can be moved after the
# Trivy scan that approved it, so a tag is not a deployable reference.
#
# The placeholders below are not real digests. Compose will still PARSE them —
# `docker compose config` only checks that the variables are set — and the
# failure surfaces later, at image pull. `task release:images:check` is what
# catches a placeholder, a typo, or a deleted image before the stack starts.
CORE_IMAGE=ghcr.io/mhosseinab/market-ops-core@sha256:...
LLM_IMAGE=ghcr.io/mhosseinab/market-ops-llm@sha256:...
NGINX_IMAGE=ghcr.io/mhosseinab/market-ops-nginx@sha256:...
GOOSE_IMAGE=ghcr.io/mhosseinab/market-ops-goose@sha256:...

# ─── PostgreSQL 18 ───────────────────────────────────────────────────────────
# core/migrate use the same DATABASE_URL. Format (loopback inside the compose
# network):
#   postgres://<USER>:<PASSWORD>@postgres:5432/<DB>?sslmode=disable
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL=

# ─── Go core ─────────────────────────────────────────────────────────────────
# base64 of exactly 32 bytes. DK access/refresh tokens are sealed at rest with
# this key; never rotate without a token re-encryption procedure.
CONNECTOR_ENCRYPTION_KEY=
# The frozen DK Seller API server. Use https://seller.digikala.com only after
# the S35 live gate approves seller access.
DK_API_BASE_URL=
# Absolute https:// origin used in digest email links (e.g.
# https://ops.example.com).
APP_BASE_URL=
# Shared random bearer token core presents on every call into the LLM plane
# (read + Draft only). Must match the value supplied to the `llm` service.
LLM_GATEWAY_TOKEN=

# ─── Optional — compose.prod.yml applies safe defaults when unset ────────────
# LOG_LEVEL=info
# CHAT_KILL_SWITCH=false
# CHAT_KILL_SWITCH_ACCOUNTS=
# SMTP_ADDR=localhost:1025
# NOTIFY_FROM_ADDR=                      # empty ⇒ daily digest job stays unwired
# NOTIFY_LOCALE=fa-IR
# NOTIFY_REGION=IR
# CURRENCY_CONTRACT_VERSION=v1
# OTEL_ENABLED=false                     # keep false until the prod collector lands
# OTEL_EXPORTER_OTLP_ENDPOINT=

# ─── LLM plane — defaults to the mock provider, no paid calls ────────────────
# Flip to openai_compatible ONLY after the S35 benchmark selects an endpoint.
# LLM_PROVIDER_KIND=mock
# LLM_PROVIDER_BASE_URL=
# LLM_PROVIDER_API_KEY=
# LLM_PROVIDER_MODEL=mock-model
# LLM_CHAT_DISABLED_GLOBAL=false

# ─── First-owner bootstrap — `task prod:bootstrap` (§10 step 9b) ─────────────
# A migrated database has schema and NO rows: no user, no organization, no
# marketplace account, and the gateway exposes no signup or invite route. These
# values feed the one-shot `bootstrap` service, which runs the same digest-pinned
# core image with the `bootstrap-owner` argument.
#
# BOOTSTRAP_OWNER_PASSWORD is deliberately absent: `task prod:bootstrap` prompts
# for it with echo disabled and passes it with `-e` for that one invocation, so
# the owner credential never comes to rest in this file.
BOOTSTRAP_OWNER_EMAIL=
BOOTSTRAP_ORG_NAME=
# The seller identifier this organization's marketplace account is keyed by.
# Globally unique; NOT NULL. Use the real DK seller id where you have one.
BOOTSTRAP_ACCOUNT_NATIVE_ID=
# Optional; defaults to BOOTSTRAP_ORG_NAME.
# BOOTSTRAP_ACCOUNT_DISPLAY_NAME=
# Rotating an existing owner's password must be a conscious act. Left false, a
# re-run reports the existing identifiers and changes nothing. Set true and
# re-run to rotate — which also revokes every live session for that user.
# BOOTSTRAP_ROTATE_PASSWORD=false

# ─── certbot — used only by the one-shot `certbot` service (§10 step 4) ──────
# Required to issue the TLS certificate for the domain nginx terminates.
DK_DOMAIN=
DK_ACME_EMAIL=
