# Production environment template for deploy/compose.prod.yml.
#
# Copy to a file the deployment account alone can read, OUTSIDE the checkout,
# and pass it explicitly:
#
#   install -m 0600 /dev/null /etc/market-ops/prod.env
#   docker compose --env-file /etc/market-ops/prod.env -f deploy/compose.prod.yml ...
#
# NEVER commit the filled-in copy. Compose uses these values for ${...}
# substitution only; each service receives just the variables its `environment:`
# block names, so nothing here leaks wholesale into a container. In particular
# the LLM plane never receives DATABASE_URL or CONNECTOR_ENCRYPTION_KEY.
#
# Every variable without a default is enforced by compose: `docker compose
# config` fails with the named message rather than starting a half-wired stack.

# ── Images ──────────────────────────────────────────────────────────────────
# Digest-pinned, from the image-digests-<version> artifact the release workflow
# uploads. Use digests, not tags: a tag can be moved, a digest cannot.
# Published only by pushing a semver v* tag on a commit reachable from main.
CORE_IMAGE=ghcr.io/mhosseinab/market-ops-core@sha256:
LLM_IMAGE=ghcr.io/mhosseinab/market-ops-llm@sha256:
NGINX_IMAGE=ghcr.io/mhosseinab/market-ops-nginx@sha256:
GOOSE_IMAGE=ghcr.io/mhosseinab/market-ops-goose@sha256:

# ── Public ingress ──────────────────────────────────────────────────────────
# The hostname whose A/AAAA records already point at this VPS. The one-shot
# certbot service issues a certificate for exactly this name before the first
# `up`; port 80 must be publicly reachable for the ACME challenge to complete.
DK_DOMAIN=
DK_ACME_EMAIL=

# ── PostgreSQL ──────────────────────────────────────────────────────────────
# Generate the password with: openssl rand -base64 24
POSTGRES_USER=market_ops
POSTGRES_PASSWORD=
POSTGRES_DB=market_ops
# Host is the compose service name. sslmode=disable is correct here and only
# here: the connection never leaves the container network. Must match the three
# values above.
DATABASE_URL=postgres://market_ops:CHANGE_ME@postgres:5432/market_ops?sslmode=disable

# ── Core secrets ────────────────────────────────────────────────────────────
# Base64 of exactly 32 bytes: openssl rand -base64 32
# DK access and refresh tokens are sealed at rest with this key. Rotating it
# without a designed re-encryption pass makes every stored token unreadable —
# back it up separately from the database.
CONNECTOR_ENCRYPTION_KEY=

# Shared read + Draft-only bearer token between core and the LLM plane.
# Generate with: openssl rand -hex 32
# Rotating it requires updating both services atomically.
LLM_GATEWAY_TOKEN=

# ── DK Seller API ───────────────────────────────────────────────────────────
# https://seller.digikala.com only after live approval. Never the mock in
# production; never a seller token here — the seller completes the DK
# authorization flow and core seals the resulting tokens itself.
DK_API_BASE_URL=https://seller.digikala.com

# ── Core behavior ───────────────────────────────────────────────────────────
# Absolute public origin, used for deep links in the daily digest email. Must
# match DK_DOMAIN or the links point somewhere the recipient cannot reach.
APP_BASE_URL=https://
LOG_LEVEL=info

# Chat can be disabled globally, or for comma-separated marketplace-account
# UUIDs, without affecting screens (CHAT-009).
CHAT_KILL_SWITCH=false
CHAT_KILL_SWITCH_ACCOUNTS=

# Empty NOTIFY_FROM_ADDR leaves the digest job unwired — the safe default. The
# current mailer speaks plain SMTP with no AUTH and no implicit TLS, so
# SMTP_ADDR must be a trusted private/loopback relay, not a public provider.
SMTP_ADDR=
NOTIFY_FROM_ADDR=
NOTIFY_LOCALE=fa-IR
NOTIFY_REGION=IR
CURRENCY_CONTRACT_VERSION=v1

# ── Observability ───────────────────────────────────────────────────────────
# compose.prod.yml ships no collector yet, so leave this false until the
# observability stack is deployed; true with no reachable endpoint just adds
# export errors.
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=

# ── LLM plane ───────────────────────────────────────────────────────────────
# `mock` makes no paid calls and is the correct value until the gated provider
# benchmark selects a qualified endpoint and records its P75 cost. Switching to
# openai_compatible before that is a budget decision, not a deployment one.
LLM_PROVIDER_KIND=mock
LLM_PROVIDER_BASE_URL=
LLM_PROVIDER_API_KEY=
LLM_PROVIDER_MODEL=mock-model
LLM_CHAT_DISABLED_GLOBAL=false
